{
  "name": "rocketlog",
  "version": "1.0.0",
  "description": "Api de entregas de encomendas",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx --watch --env-file .env src/server.ts",
    "test:dev": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --runInBand",
    "build": "tsup src --out-dir build --format esm --clean",
    "start": "node build/server.js",
    "postinstall": "prisma generate"
  },
  "author": "Lucas Castro",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^5.5.4"
  }
}
